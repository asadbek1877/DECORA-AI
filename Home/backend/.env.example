# =============================================
#  AI Interior Designer — Backend .env.example
#  Copy this file to .env and fill in real values
# =============================================

# ─── Server ────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT Authentication ────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64
JWT_EXPIRES_IN=7d

# ─── AI Provider Selection ─────────────────────────
# Options: mock | fal | huggingface | replicate | gemini | segmind
# mock        = demo mode, no real AI, free, instant
# fal         = fal.ai FLUX ControlNet img2img
# huggingface = real AI via Hugging Face Inference API (FREE)
# replicate   = real AI via Replicate (PAID — costs 1 credit per generation)
# gemini      = Google Gemini image model (free tier)
# segmind     = Segmind img2img endpoint
ACTIVE_AI_PROVIDER=mock

# ─── Segmind AI (Img2Img) ──────────────────────
# Get key from: https://cloud.segmind.com/console/api-keys
SEGMIND_API_KEY=SG_YOUR_KEY_HERE
# Example endpoint (change to your selected model endpoint)
SEGMIND_API_URL=https://api.segmind.com/v1/sd1.5-img2img

# ─── fal.ai (Img2Img) ───────────────────────────
# Get key from: https://fal.ai/dashboard/keys
FAL_KEY=YOUR_FAL_KEY_HERE

# ─── Google Gemini AI ───────────────────────────
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# ─── Replicate AI (Paid) ──────────────────────
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_YOUR_TOKEN_HERE

# ─── Hugging Face AI (Free) ────────────────────
# Get free token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_YOUR_TOKEN_HERE

# ─── Cloudinary (Image Storage) ───────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── Database (SQLite — local file) ───────
DATABASE_URL="file:./dev.db"

# ─── Storage ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Frontend URL (CORS) ─────────────────
# Comma-separated list of allowed origins (NO wildcards in production!)
# Example: http://localhost:5173,https://your-domain.com
FRONTEND_URL=http://localhost:5173,http://localhost:3000
