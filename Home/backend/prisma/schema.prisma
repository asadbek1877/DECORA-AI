// =============================================
//  AI Interior Designer — Prisma Schema (SQLite)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── User ─────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  credits      Int      @default(3) // 3 бепул кредит рўйхатдан ўтганда
  lastCreditRefillAt DateTime @default(now()) @map("last_credit_refill_at")
  role         String   @default("USER") // USER | ADMIN
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  projects Project[]
  likes    Like[]
  comments Comment[]

  @@map("users")
}

// ─── Project (Дизайн лойиҳа) ─────────────
model Project {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  originalImageUrl  String   @map("original_image_url")  // Cloudinary URL
  originalPublicId  String?  @map("original_public_id")  // Cloudinary public_id
  style             String?  // Танланган стил номи
  styleName         String?  @map("style_name")
  prompt            String?
  roomType          String?  @map("room_type") // "bedroom", "living_room", etc.
  status            String   @default("UPLOADED") // UPLOADED | PREVIEWING | GENERATING | COMPLETED | FAILED
  isPublic          Boolean  @default(false) @map("is_public") // Community feed учун
  shareToken        String?  @unique @map("share_token")
  isDeleted         Boolean  @default(false) @map("is_deleted")   // Soft delete
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedImages GeneratedImage[]
  promptHistory   PromptHistory[]
  likes           Like[]
  comments        Comment[]
  estimates       Estimate[]

  @@index([userId])
  @@index([isPublic])
  @@index([isDeleted])
  @@map("projects")
}

// ─── Generated Image (AI яратган расм) ────
model GeneratedImage {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  styleName   String   @map("style_name")  // "minimalism", "luxury", etc.
  imageUrl    String   @map("image_url")    // Cloudinary URL
  publicId    String?  @map("public_id")    // Cloudinary public_id
  imageType   String   @default("PREVIEW")  // PREVIEW | FINAL
  prompt      String?  // Replicate-га юборилган prompt
  modelUsed   String?  @map("model_used")
  analysis    String?  // AI тавсифи / таҳлили
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([imageType])
  @@map("generated_images")
}

// ─── Prompt History (Промпт тарихи) ───────
model PromptHistory {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  prompt     String   // Ишлатилган промпт
  styleName  String?  @map("style_name")
  roomType   String?  @map("room_type")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("prompt_history")
}

// ─── Like (Лайклар) ───────────────────────
model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId]) // Бир фойдаланувчи бир марта лайк қўяди
  @@index([projectId])
  @@map("likes")
}

// ─── Comment (Шарҳлар) ────────────────────
model Comment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("comments")
}

// ─── Estimate (AI смета / таҳлил) ─────────
model Estimate {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  estimateData String   @map("estimate_data")   // JSON: AI чиқарган смета маълумотлари
  chatHistory  String?  @map("chat_history")     // JSON: чат тарихи (multi-turn)
  totalCost    Float?   @map("total_cost")       // Умумий нарх (агар бўлса)
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("estimates")
}

// ─── App Settings (App Sozlamalari) ──────
model AppSettings {
  id              String   @id @default("singleton") // 1 ta yozuv bo'ladi
  beforeImageUrl  String   @map("before_image_url")  // Cloudinary URL
  afterImageUrl   String   @map("after_image_url")   // Cloudinary URL
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─── Trial Demo Images (Пробный Режим) ────
// Бош менюдаги "Текинга синаб кўриш" учун админ томондан кўрсатиладиган 5 та расм
model TrialDemo {
  id              String   @id @default(uuid())
  title           String?  // Расм номи (масалан: "Living Room 1")
  beforeImageUrl  String   @map("before_image_url")  // Cloudinary URL Original
  beforePublicId  String?  @map("before_public_id")  // Cloudinary public_id
  isActive        Boolean  @default(true) @map("is_active")
  order           Int      @default(0) // 5 тани тартиблаш учун
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  variants        TrialDemoVariant[]

  @@map("trial_demos")
}

model TrialDemoVariant {
  id              String   @id @default(uuid())
  trialDemoId     String   @map("trial_demo_id") // Қайси TrialDemo га тегишли
  styleName       String   @map("style_name")    // "Modern", "Classic", "Industrial"
  afterImageUrl   String   @map("after_image_url") // Cloudinary URL Generated
  afterPublicId   String?  @map("after_public_id") // Cloudinary public_id
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  trialDemo       TrialDemo @relation(fields: [trialDemoId], references: [id], onDelete: Cascade)

  @@index([trialDemoId])
  @@map("trial_demo_variants")
}

// ─── Gallery Item (До/После галерея) ──────
// Ҳар бир интерьер лойиҳа учун ҳам бир GalleryItem
model GalleryItem {
  id          String   @id @default(uuid())
  title       String?  // Галерея номи (масалан: "Living Room Design")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  images      GalleryImage[]

  @@map("gallery_items")
}

// ─── Gallery Image (Расмлари - Until/Before/After) ───────
// Ҳар бир GalleryItem га камо-камо расм (before, after modern, after minimal, etc.)
model GalleryImage {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  type        String   // "before" | "after"
  style       String?  // "modern", "minimal", "scandinavian", etc. (null for before)
  path        String   // Cloudinary path: /gallery/{item_id}/{type}/{style}/1.jpg
  publicId    String?  @map("public_id") // Cloudinary public_id
  order       Int      @default(0) // Ҳар бир стилнинг ичида расмларни тартиблаш
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  item        GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, type, style])
  @@map("gallery_images")
}
